// ============================================================================
// PaletteGenerationCIEDE.compute —— 帧级调色板（P5）的 **LUT 烘焙器**
//
// 【它在烘什么】把一张 RGB 均匀立方（每个格子的中心色）映射到**调色板里最近的那个色**，
// 最近邻的度量用 **CIEDE2000**（感知均匀色差），结果写成一张 **2D RGB 条带 LUT**：
//   LUT 尺寸 = (res×res) × res，其中 res = 调色板分辨率（默认 16 ⇒ 256×16）
//   LUT 纹理坐标 (x, y) 与颜色的关系（与 `PixelartColorCorrection.shader` 的采样公式互为逆）：
//     x = r/res + floor(b·res)/res      ← 横向按蓝通道分片、片内是红通道
//     y = 1 - g                         ← 纵向是绿通道（反向）
//   ⇒ 一个 (r,g,b) 的"显示空间"颜色就能落到一个纹素上；采样器点采样 ⇒ 输出**正好是板上的一个色**。
//
// 【为什么必须自己 Dispatch】本 kernel 是 `[numthreads(8,8,8)]` + **三维派发**
//   （x = 红索引、y = 绿索引、z = 蓝索引）。通用 `ComputeShaderPass` 的 z 恒为 1 装不下
//   （蓝图 §4.2/§6 P5 明确点过这一条），所以 C# 侧（`PixelartPalette.BuildLut`）像
//   v3 `SloanePixelartPalette.cs:62-63` 一样自己算 `CeilToInt(res/8)` 三维派发。
//
// 【色差数学 = v3 `PaletteGenerationCIEDE.compute:45-95` 逐行】CIEDE2000 全套
//   （含 `my_sin/my_cos` 的**度数版**——那两行不是笔误：v3 的角度全按度算，换成弧度就整条错）。
//
// 【本仓与 v3 的两处差异，都写在注释里】
//   ① **越界 guard 用 `>=` 而不是 `>`**：v3 的 `if(id.x > _Resolution ...)` 会多算一行/一列
//      （蓝图 §4.4 末尾点过这条），res 不被 8 整除时 z 方向甚至写出 LUT 之外。
//   ② 不 include URP 的 `Core.hlsl`：本 kernel 一行 URP API 都不用（蓝图 §4.2 的"砍掉不带的依赖"
//      同一条纪律），少一层 include 就少一处"换个包版本就编不过"。
// ============================================================================

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

#pragma kernel Main

// ---- 与 C# 侧的名字契约（`PixelartPalette` 里的 PropertyToID 逐字对应）----
RWTexture2D<float4> _OutputBuffer;   // 目标：res×res 宽 × res 高的 LUT（R8G8B8A8_UNorm）
StructuredBuffer<float3> _Palette;   // 调色板色（**线性**，与 Assets 里 Color 的分量一致）
uint _Resolution;                    // LUT 分辨率（= LUT 高度，默认 16）
uint _Count;                         // 调色板色数

// https://www.shadertoy.com/view/msXyz8（v3 的出处）
static const float kEpsilon = 0.00001;

// 【度数版三角函数】v3 的 CIEDE2000 全程按**度**算角（h 用 degrees(atan2)），故这里不能直接用 rad 版。
float my_sin(float x) { return sin(radians(x)); }
float my_cos(float x) { return cos(radians(x)); }

float my_atan(float y, float x)
{
    float v = degrees(atan2(y, x));
    return (v < 0.0) ? v + 360.0 : v;
}

float get_h(float a, float b)
{
    bool a_and_b_are_zeros = (abs(a) < kEpsilon) && (abs(b) < kEpsilon);
    return a_and_b_are_zeros ? 0.0 : my_atan(b, a);
}

float get_delta_h(float C1, float C2, float h1, float h2)
{
    float diff = h2 - h1;
    return (C1 * C2 < kEpsilon) ? 0.0
        : (abs(diff) <= 180.0) ? diff
        : (diff > 180.0) ? diff - 360.0
        : diff + 360.0;
}

float get_h_bar(float C1, float C2, float h1, float h2)
{
    float dist = abs(h1 - h2);
    float sum = h1 + h2;
    return (C1 * C2 < kEpsilon) ? h1 + h2
        : (dist <= 180.0) ? 0.5 * sum
        : (sum < 360.0) ? 0.5 * (sum + 360.0)
        : 0.5 * (sum - 360.0);
}

// CIEDE2000（v3 `:45-95` 逐行；Lab 已归一化到 [0,1] 那一档，见 `rgb2lab`）
float calculate_CIEDE2000(float3 Lab1, float3 Lab2)
{
    float L1 = Lab1.x; float a1 = Lab1.y; float b1 = Lab1.z;
    float L2 = Lab2.x; float a2 = Lab2.y; float b2 = Lab2.z;

    float C1_ab = sqrt(a1 * a1 + b1 * b1);
    float C2_ab = sqrt(a2 * a2 + b2 * b2);
    float C_ab_bar = 0.5 * (C1_ab + C2_ab);
    float G = 0.5 * (1.0 - sqrt(pow(C_ab_bar, 7.0) / (pow(C_ab_bar, 7.0) + pow(25.0, 7.0))));
    float a_1 = (1.0 + G) * a1;
    float a_2 = (1.0 + G) * a2;
    float C1 = sqrt(a_1 * a_1 + b1 * b1);
    float C2 = sqrt(a_2 * a_2 + b2 * b2);
    float h1 = get_h(a_1, b1);
    float h2 = get_h(a_2, b2);

    float delta_L = L2 - L1;
    float delta_C = C2 - C1;
    float delta_h = get_delta_h(C1, C2, h1, h2);
    float delta_H = 2.0 * sqrt(C1 * C2) * my_sin(0.5 * delta_h);

    float L_bar = 0.5 * (L1 + L2);
    float C_bar = 0.5 * (C1 + C2);
    float h_bar = get_h_bar(C1, C2, h1, h2);

    float T = 1.0 - 0.17 * my_cos(h_bar - 30.0) + 0.24 * my_cos(2.0 * h_bar)
        + 0.32 * my_cos(3.0 * h_bar + 6.0) - 0.20 * my_cos(4.0 * h_bar - 63.0);

    float delta_theta = 30.0 * exp(-((h_bar - 275.0) / 25.0) * ((h_bar - 275.0) / 25.0));

    float R_C = 2.0 * sqrt(pow(C_bar, 7.0) / (pow(C_bar, 7.0) + pow(25.0, 7.0)));
    float S_L = 1.0 + (0.015 * (L_bar - 50.0) * (L_bar - 50.0)) / sqrt(20.0 + (L_bar - 50.0) * (L_bar - 50.0));
    float S_C = 1.0 + 0.045 * C_bar;
    float S_H = 1.0 + 0.015 * C_bar * T;
    float R_T = -my_sin(2.0 * delta_theta) * R_C;

    const float k_L = 1.0;
    const float k_C = 1.0;
    const float k_H = 1.0;

    float deltaL = delta_L / (k_L * S_L);
    float deltaC = delta_C / (k_C * S_C);
    float deltaH = delta_H / (k_H * S_H);

    float delta_E_squared = deltaL * deltaL + deltaC * deltaC + deltaH * deltaH + R_T * deltaC * deltaH;

    return sqrt(delta_E_squared);
}

// sRGB → XYZ（D65），再 XYZ → Lab；返回的 Lab 被归一到"L/100、a/127 后偏 0.5、b/127 后偏 0.5"。
// 【注意这个归一化与 CIEDE2000 的配合】v3 就是这么配的（`:114-117` 与 `CalculateColorDiff`），
// 换了归一化方式（比如不偏 0.5）会让 G/S_L/S_C/S_H 各项整体改尺度、最近邻结论跟着变。
float3 rgb2xyz(float3 c)
{
    float3 tmp;
    tmp.x = (c.r > 0.04045) ? pow((abs(c.r + 0.055)) / 1.055, 2.4) : c.r / 12.92;
    tmp.y = (c.g > 0.04045) ? pow((abs(c.g + 0.055)) / 1.055, 2.4) : c.g / 12.92;
    tmp.z = (c.b > 0.04045) ? pow((abs(c.b + 0.055)) / 1.055, 2.4) : c.b / 12.92;
    return 100.0 * mul(tmp, float3x3(0.4124, 0.3576, 0.1805,
                                     0.2126, 0.7152, 0.0722,
                                     0.0193, 0.1192, 0.9505));
}

float3 xyz2lab(float3 c)
{
    float3 n = c / float3(95.047, 100.0, 108.883);
    float3 v;
    v.x = (n.x > 0.008856) ? pow(abs(n.x), 1.0 / 3.0) : (7.787 * n.x) + (16.0 / 116.0);
    v.y = (n.y > 0.008856) ? pow(abs(n.y), 1.0 / 3.0) : (7.787 * n.y) + (16.0 / 116.0);
    v.z = (n.z > 0.008856) ? pow(abs(n.z), 1.0 / 3.0) : (7.787 * n.z) + (16.0 / 116.0);
    return float3((116.0 * v.y) - 16.0, 500.0 * (v.x - v.y), 200.0 * (v.y - v.z));
}

float3 rgb2lab(float3 c)
{
    float3 lab = xyz2lab(rgb2xyz(c));
    return float3(lab.x / 100.0, 0.5 + 0.5 * (lab.y / 127.0), 0.5 + 0.5 * (lab.z / 127.0));
}

float CalculateColorDiff(float3 color0, float3 color1)
{
    float3 lab1 = rgb2lab(color0);
    float3 lab2 = rgb2lab(color1);
    return calculate_CIEDE2000(lab1, lab2);
}

// 【口径提醒】两个参数都要是 **sRGB 编码值**：`rgb2lab` 内部先做 sRGB→线性。
//   本 kernel 的 `inputColor` 来自采样格中心，天然是 sRGB 编码的显示空间值；
//   而 `_Palette[i]` 是 Unity `Color` 的分量（线性工程里是**线性**值）。
//   v3 两边都直接喂进来（`:148`），即调色板色被**多解码了一次**、比实际偏暗。
//   本仓照 v3 保留（契约 §4.5 要求"照 v3"），成因与影响记在交付报告里：
//   若要修，只改这一处——把 `_Palette[i]` 先 `LinearToSRGB` 再喂进 `CalculateColorDiff`。
float3 linear2srgb(float3 c)
{
    float3 srgb;
    srgb.x = (c.x <= 0.0031308) ? (12.9232102 * c.x) : (1.055 * pow(abs(c.x), 1.0 / 2.4) - 0.055);
    srgb.y = (c.y <= 0.0031308) ? (12.9232102 * c.y) : (1.055 * pow(abs(c.y), 1.0 / 2.4) - 0.055);
    srgb.z = (c.z <= 0.0031308) ? (12.9232102 * c.z) : (1.055 * pow(abs(c.z), 1.0 / 2.4) - 0.055);
    return srgb;
}

[numthreads(8, 8, 8)]
void Main(uint3 id : SV_DispatchThreadID)
{
    // 三维派发按 CeilToInt(res/8) 给足余量 ⇒ 这里必须用 `>=` 挡住越界线程
    //（v3 用 `>`，会多算一行一列并写到 LUT 之外的高度；蓝图 §4.4 末尾）。
    if (id.x >= _Resolution || id.y >= _Resolution || id.z >= _Resolution)
        return;

    // (x, y, z) = (红索引, 绿索引, 蓝索引)；输出坐标与采样公式互为逆（见文件头）。
    uint2 outputCoord = uint2(id.z * _Resolution + id.x, _Resolution - id.y - 1);
    float3 inputColor = float3(((float)id.x + 0.5) / (float)_Resolution,
                               ((float)id.y + 0.5) / (float)_Resolution,
                               ((float)id.z + 0.5) / (float)_Resolution);

    float minDiff = 65535.0;
    uint minDiffIndex = 0;

    for (uint i = 0; i < _Count; i++)
    {
        float diff = CalculateColorDiff(_Palette[i], inputColor);
        if (diff < minDiff)
        {
            minDiff = diff;
            minDiffIndex = i;
        }
    }

    // 吐出的是调色板色的**原值**（线性）⇒ 采样后写进非 sRGB 的颜色目标 = 显示成原色，
    // 与"调色板色 = Unity Color 分量"这套口径自洽（本次质变只在"用什么色"，不在颜色空间）。
    _OutputBuffer[outputCoord] = float4(_Palette[minDiffIndex], 1.0);
}
