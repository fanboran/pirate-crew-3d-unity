// 实验水体 · 浅水方程模拟内核（W1）。
//
// 架构与公式单源：PirateCrew.WaterLab.WaterLabRules（纯 C#，harness 钉契约）；
// 参照思路来源：Sandcastle Demo 逆向（kernel 名与常量名见
// docs/技术/渲染/调研/Sandcastle水体逆向.md），代码自写，不含第三方代码。
//
// 缓冲约定（每帧调度序，A/B 交替读写保证 kernel 内全场一致）：
//   HeightIntegration A→B（质量通量，读 4 邻）
//   VelocityIntegration B→A（动量梯度，读 4 邻）
//   AdvectFoam        A→B（泡沫回溯/生成/衰减/扩散，读 4 邻）
//   WetnessStep       C→D（湿沙浸润/蒸发/扩散，读 4 邻，地形分辨率）
//   （子步末 A/B 换位，最新水场落在 A）
//   SurfaceUpdate     A→A（帧末一次：蒸发 + 全场潮位松弛，无邻域读；原作 UpdateAmount）
//   OutputField       读 A，写 _WaterLabHeightTex（水场输出，水分辨率）
//                     同 kernel 顺带写 _WaterLabCausticTex（焦散烘焙：η 四邻均值−中心
//                     的带符号拉普拉斯——邻域本就为法线算好，零额外采样；增益留在
//                     渲染材质侧 _CausticGain，RT 只存物理量。对标原作「焦散由引擎
//                     侧渲 RT、材质只采 causticsMap」的外包分工）
//   WhitewaterBegin   清活粒子计数（1 线程）
//   WhitewaterSpawn   读 B 泡沫，超阈值按概率写粒子缓冲环（环游标跨步连续）
//   WhitewaterUpdate  粒子平流+贴水面弹簧+寿命衰减（64 线程/组，容量域）
//   WhitewaterCompact 活粒子槽位写 drawList（InterlockedAdd 产出紧凑列表）
//   WhitewaterEnd     写 DrawProceduralIndirect args (6, count, 0, 0)（1 线程）
// 帧末最新水场在 A（SurfaceUpdate 后）、最新湿沙在 D；下一帧驱动侧把 (A,D) 当输入。
// 本文件不写任何数值常量的默认值——全部由 C# 侧按 WaterLabRules 下发（防双源漂移）。

#pragma kernel SurfaceUpdate
#pragma kernel HeightIntegration
#pragma kernel VelocityIntegration
#pragma kernel AdvectFoam
#pragma kernel WetnessStep
#pragma kernel OutputField
#pragma kernel WhitewaterBegin
#pragma kernel WhitewaterSpawn
#pragma kernel WhitewaterUpdate
#pragma kernel WhitewaterCompact
#pragma kernel WhitewaterEnd

RWStructuredBuffer<float4> _WaterA;   // x=h(水深) y=vx z=vz w=foam，256²
RWStructuredBuffer<float4> _WaterB;
StructuredBuffer<float> _Ground;      // 地形高程（世界 Y），128²，只读静态
RWStructuredBuffer<float> _WetA;      // 湿沙 [0,1]，128²
RWStructuredBuffer<float> _WetB;
RWTexture2D<float4> _WaterLabHeightTex; // 输出：R=η(编码) G,B=法线xz(编码) A=泡沫（与渲染 shader 全局同名）
RWTexture2D<float4> _WaterLabCausticTex; // 输出：R=焦散拉普拉斯（带符号，凹聚正/凸散负；与渲染 shader 全局同名）
RWTexture2D<float> _WaterLabWetTex;     // 输出：R=湿沙（与渲染 shader 全局同名）

// 白水粒子（W4，对标 Whitewater：泡沫场实例化，Compact 写 drawList、End 写 drawArgs）
RWStructuredBuffer<float4> _WWPos;   // xyz=世界坐标 w=寿命 [0,1]，容量 _WwCapacity（缓冲环）
RWStructuredBuffer<float4> _WWVel;   // xyz=速度 w=基准尺寸 (m)
RWStructuredBuffer<uint> _WWDraw;    // draw list：活粒子槽位（Compact 产出，渲染侧按实例号查）
RWStructuredBuffer<uint> _WWAlive;   // [0]=本步活粒子计数（Begin 清零）[1]=缓冲环写游标（跨步连续）
RWStructuredBuffer<uint> _WWArgs;    // DrawProceduralIndirect 参数 (6, count, 0, 0)

// ---- C# 下发常量（名字与 WaterLabRules 对齐）----
int _Cells;              // 水域每轴格数 (256)
float _CellSize;         // 水格距 (0.25)
int _GroundCells;        // 地形每轴格数 (128)
float _GroundCellSize;   // 地形格距 (0.5)
float _HalfDomain;       // 半域宽 (32)

float _Dt;
float _Gravity;
float _Damping;
float _MaxVelocity;
float _DryDepth;
float _Time;
float _SeaLevel;

// 半拉格朗日水量平流系数（原作 WaterProperty.advectionFactor=0.2）
float _AdvectionFactor;
// 动量时间低通系数（原作 WaterProperty.kappa=1000）
float _Kappa;
// ---- 原作 UpdateAmount 的潮位松弛（每帧一次，见 SurfaceUpdate）----
float _WaveAmplitude;        // max(0.01, saturate(playTime×0.05)×0.2)，CPU 每帧算好
float _TideClampMin;         // clamp(wave·sin(playTime), −0.5, +∞) 的下钳
float _TideMinAmount;        // max(level−ground+wave, 0.05) 的 5 cm 结合水下限
float _CouplingWeight;       // 归一化耦合权重 0..1（原作 4 bit/15）；本仓按初始淹没区取满/干区取 0
float _EvaporationRate;      // exp(−0.721348·湿度)×sun·evaporationFactor×0.001（m/s）

float _BreakingSteepness;   // H/h 破碎阈值（0.78，Miche 准则工程版）
float _BreakingFroude;      // = _BreakingSteepness/2（浅水 u=a√(g/h)、c=√(gh) ⇒ a/h=Fr，
                            //   故「H/h>0.78（H=2a）」等价于 Fr>0.39；AdvectFoam 用此值）
float _FoamGain;
float _FoamDecay;
float _FoamDiffuse;

float _WetSoakRate;
float _WetEvaporateRate;
float _WetDiffuse;

int _SpongeCells;
float _SpongeMaxDamping;

int _WwCapacity;            // 粒子池容量（32768，WaterLabRules.WhitewaterCapacity）
float _WwLifetime;          // 粒子寿命 (s)
float _WwSpawnThreshold;    // 生成阈值（泡沫浓度）
float _WwSpawnRate;         // 生成产率系数 (1/s)
float _WwSize;              // 粒子基准尺寸 (m)
// 白水粒子的水面上抬量（m）。原作 Whitewater VS：粒子世界高度 =
// max(amount−0.05,0) + 0.02；本仓粒子在世界坐标里，等价式再加 ground。
float _WwSurfaceOffset;
// 相机视锥平面（世界空间：xyz=法线 n、w=距离 d；内侧判据 dot(n,p)+d ≥ 0）
// 与视锥外扩（原作 Culling.frustumOverscan = 0.1，见 WaterLabRules.WhitewaterFrustumOverscan）
float4 _WwFrustumPlanes[6];
float _WwFrustumOverscan;


// ---- 共用采样 ----

// 水格坐标（连续，格心 +0.5）→ 地形高程，地形双线性（地形格距是水格 2 倍）
float SampleGround(float2 cellXY)
{
    float2 g = cellXY * _CellSize / _GroundCellSize; // 水格→地形格连续坐标
    float2 p = clamp(g, float2(0.5, 0.5), float2(_GroundCells - 1.5, _GroundCells - 1.5));
    int2 i0 = int2(floor(p - 0.5) + 0.5);
    float2 f = p - (i0 + 0.5);
    int2 i1 = min(i0 + 1, _GroundCells - 1);
    float a = _Ground[i0.x + i0.y * _GroundCells];
    float b = _Ground[i1.x + i0.y * _GroundCells];
    float c = _Ground[i0.x + i1.y * _GroundCells];
    float d = _Ground[i1.x + i1.y * _GroundCells];
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

// 水场 yzw（速度+泡沫）双线性采样（clamp 边界）
float3 SampleWaterVelFoam(RWStructuredBuffer<float4> buf, float2 cellXY)
{
    float2 p = clamp(cellXY, float2(0.0, 0.0), float2(_Cells - 1, _Cells - 1));
    int2 i0 = int2(floor(p));
    float2 f = p - i0;
    int2 i1 = min(i0 + 1, _Cells - 1);
    float4 a = buf[i0.x + i0.y * _Cells];
    float4 b = buf[i1.x + i0.y * _Cells];
    float4 c = buf[i0.x + i1.y * _Cells];
    float4 d = buf[i1.x + i1.y * _Cells];
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y).yzw;
}

// 距域边（z 两侧）的最小格距
float BorderDistance(int2 c)
{
    return min(c.y, _Cells - 1 - c.y);
}

// ---- kernel：UpdateAmount（每帧一次，原地）----
// 原作顺序：蒸发 → 泵 → 潮位松弛。本仓实验室没有 obstaclesMap（泵的 0.1 窗口
// 门控依赖障碍物顶高），故只落蒸发与潮位松弛两条；泵在文档对账表里记为缺口。
// 潮位目标全场统一 = SeaLevel + clamp(amp·sin(playTime), −0.5, +∞)，逐格按
// 4 bit 耦合权重/15（C# 已归一化到 0..1）松弛（每帧比例，不乘 dt）。
// 旧四列行波是本仓自推，已删除。
[numthreads(8, 8, 1)]
void SurfaceUpdate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Cells || id.y >= (uint)_Cells) return;
    int2 c = int2(id.x, id.y);
    int i = c.x + c.y * _Cells;
    float4 w = _WaterA[i];
    float g = SampleGround(c + 0.5);

    // 蒸发：h -= exp(−0.721348·湿度)·sun·factor·0.001·dt（原作 UpdateAmount 首段）
    float h = max(w.x - _EvaporationRate * _Dt, 0.0);

    // 潮位松弛：target = max(level − ground + clamp(amp·sin(t), −0.5, +∞), 0.05)
    float tide = _SeaLevel + max(_WaveAmplitude * sin(_Time), _TideClampMin);
    float target = max(tide - g, _TideMinAmount);

    // 耦合权重（已由 C# 归一化到 0..1，原作是 4 bit/15）：本仓以初始淹没区满耦合、
    // 初始干区 0 耦合的静态代理近似（C 级，见 WaterLabRules.CouplingWeightAt）。
    float coupling = (g < _SeaLevel) ? _CouplingWeight : 0.0;
    h = lerp(h, target, coupling);

    _WaterA[i] = float4(h, w.y, w.z, w.w);
}

// ---- kernel：质量方程（平均通量，读 A 写 B）----
[numthreads(8, 8, 1)]
void HeightIntegration(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Cells || id.y >= (uint)_Cells) return;
    int2 c = int2(id.x, id.y);
    int i = c.x + c.y * _Cells;
    float4 w = _WaterA[i];
    float h = w.x;

    // 4 邻（bool 标记出界＝反射墙）。墙界面质量通量显式为 0——「越界取自身」会留
    // F = d·v 的假通量破坏守恒（与 CPU 参考同式，harness 钉契约）。
    bool bl = c.x > 0;
    bool br = c.x < _Cells - 1;
    bool bd = c.y > 0;
    bool bu = c.y < _Cells - 1;
    float4 wl = _WaterA[bl ? i - 1 : i];
    float4 wr = _WaterA[br ? i + 1 : i];
    float4 wd = _WaterA[bd ? i - _Cells : i];
    float4 wu = _WaterA[bu ? i + _Cells : i];

    // 平均通量 F = d̄·v̄（半格界面），d = max(h − _DryDepth, 0)。
    // 原作 WATER_SATURATION_POINT=0.05：前 5 cm 是贴沙结合水，不参与流动；通量用 d 而非 h。
    // 界面级迎风施主门：只有通量来向的格子 d>0 才放行——湿格可以把水推上干滩（run-up），
    // 干格不能凭平均速度凭空吐水。两侧格对同一界面必须算出同一 F（界面格式守恒的关键）。
    float dC = max(h - _DryDepth, 0.0);
    float dL = max(wl.x - _DryDepth, 0.0);
    float dR = max(wr.x - _DryDepth, 0.0);
    float dD = max(wd.x - _DryDepth, 0.0);
    float dU = max(wu.x - _DryDepth, 0.0);

    float vL = (wl.y + w.y) * 0.5;
    float vR = (w.y + wr.y) * 0.5;
    float vD = (wd.z + w.z) * 0.5;
    float vU = (w.z + wu.z) * 0.5;

    float fluxL = (bl && ((vL > 0.0) ? dL : dC) > 0.0) ? ((dL + dC) * 0.5) * vL : 0.0;
    float fluxR = (br && ((vR > 0.0) ? dC : dR) > 0.0) ? ((dC + dR) * 0.5) * vR : 0.0;
    float fluxD = (bd && ((vD > 0.0) ? dD : dC) > 0.0) ? ((dD + dC) * 0.5) * vD : 0.0;
    float fluxU = (bu && ((vU > 0.0) ? dC : dU) > 0.0) ? ((dC + dU) * 0.5) * vU : 0.0;

    float hNew = h - _Dt / _CellSize * ((fluxR - fluxL) + (fluxU - fluxD));
    hNew = max(hNew, 0.0); // 无负水深（数值保护）

    _WaterB[i] = float4(hNew, w.yzw);
}

// ---- kernel：动量方程（水面高程梯度，读 B 写 A）----
[numthreads(8, 8, 1)]
void VelocityIntegration(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Cells || id.y >= (uint)_Cells) return;
    int2 c = int2(id.x, id.y);
    int i = c.x + c.y * _Cells;
    float4 w = _WaterB[i];

    if (w.x <= _DryDepth)
    {
        _WaterA[i] = float4(w.x, 0, 0, w.w);
        return;
    }

    int il = (c.x > 0) ? i - 1 : i;
    int ir = (c.x < _Cells - 1) ? i + 1 : i;
    int idn = (c.y > 0) ? i - _Cells : i;
    int iup = (c.y < _Cells - 1) ? i + _Cells : i;
    float4 wl = _WaterB[il];
    float4 wr = _WaterB[ir];
    float4 wd = _WaterB[idn];
    float4 wu = _WaterB[iup];

    // η = ground + max(h − _DryDepth, 0)：前 5 cm 是结合水，不产生水面坡度。
    // 原作 HeightIntegration 同式（depth = max(h−0.05,0)、η = ground + depth）。
    float etaL = SampleGround(max(c - int2(1, 0), int2(0, 0)) + 0.5) + max(wl.x - _DryDepth, 0.0);
    float etaR = SampleGround(min(c + int2(1, 0), int2(_Cells - 1, _Cells - 1)) + 0.5) + max(wr.x - _DryDepth, 0.0);
    float etaD = SampleGround(max(c - int2(0, 1), int2(0, 0)) + 0.5) + max(wd.x - _DryDepth, 0.0);
    float etaU = SampleGround(min(c + int2(0, 1), int2(_Cells - 1, _Cells - 1)) + 0.5) + max(wu.x - _DryDepth, 0.0);

    float sx = (etaR - etaL) / (2.0 * _CellSize);
    float sz = (etaU - etaD) / (2.0 * _CellSize);

    // 原作 VelocityIntegration：v += -dt·(g·∇η + damping·v)，damping=0（WaterProperty 真值）。
    // 末尾按 kappa 做时间低通（原作 v=(v_new·κ+v_old)/(κ+4)，κ=1000），这是原作动量步的
    // 阻尼来源；surf zone 的 h 前缘摊开则由 AdvectFoam 里的半拉格朗日平流承担。
    float vxNew = w.y - _Dt * (_Gravity * sx + _Damping * w.y);
    float vzNew = w.z - _Dt * (_Gravity * sz + _Damping * w.z);
    float vx = (vxNew * _Kappa + w.y) / (_Kappa + 4.0);
    float vz = (vzNew * _Kappa + w.z) / (_Kappa + 4.0);

    // 限幅
    float sp = length(float2(vx, vz));
    if (sp > _MaxVelocity)
    {
        float k = _MaxVelocity / sp;
        vx *= k;
        vz *= k;
    }

    // z 两侧海绵：速度阻尼（平方曲线），吸收侧向行波。原作 VelocityIntegration
    // 自带边界阻尼（uv 缩放的 smoothstep 掩码）；本仓用同构海绵近似。放在速度步
    // 而不是表面步，保证 UpdateAmount 每帧只做一次（原作调度序）。
    float bd = BorderDistance(c);
    if (bd < (float)_SpongeCells)
    {
        float t2 = 1.0 - bd / max(_SpongeCells, 1);
        float sigma = _SpongeMaxDamping * t2 * t2;
        float damp = exp(-sigma * _Dt);
        vx *= damp;
        vz *= damp;
    }

    _WaterA[i] = float4(w.x, vx, vz, w.w);
}

// ---- kernel：泡沫（回溯 + 破碎生成 + 衰减 + 扩散，读 A 写 B）----
[numthreads(8, 8, 1)]
void AdvectFoam(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Cells || id.y >= (uint)_Cells) return;
    int2 c = int2(id.x, id.y);
    int i = c.x + c.y * _Cells;
    float4 w = _WaterA[i];

    // 半拉格朗日回溯：沿速度场反推采样点（格心索引坐标：格 c 的格心 = c）
    float2 back = c - w.yz * _Dt / _CellSize;
    float3 sampled = SampleWaterVelFoam(_WaterA, back);
    float foam = sampled.z; // 旧泡沫浓度（回溯点）

    // 原作 Advection kernel：沿速度场回溯、双线性采样水量 h，位移乘 advectionFactor=0.2。
    // 这是原作对 h 场的唯一平流/数值耗散项——没有它，bore 前缘会以数值激波形态
    // 一路保持到岸线；有了它，前缘每个子步被摊开约 0.05 格（v=2 m/s 时）。
    // 坐标口径同原作：UV 回溯后 ×N−0.5 得格心索引（反汇编 `uv*resolution−0.5`）。
    float2 backH = c - w.yz * _AdvectionFactor * _Dt / _CellSize;
    float2 pb = clamp(backH, float2(0.0, 0.0), float2(_Cells - 1, _Cells - 1));
    int2 h0 = int2(floor(pb));
    float2 fh = pb - h0;
    int2 h1 = min(h0 + 1, _Cells - 1);
    float h00 = _WaterA[h0.x + h0.y * _Cells].x;
    float h10 = _WaterA[h1.x + h0.y * _Cells].x;
    float h01 = _WaterA[h0.x + h1.y * _Cells].x;
    float h11 = _WaterA[h1.x + h1.y * _Cells].x;
    float hAdv = lerp(lerp(h00, h10, fh.x), lerp(h01, h11, fh.x), fh.y);

    // 破碎生成：弗劳德数判据（质点速 > 浅水波速 ⇒ 超临界涌潮/卷破，计划书 W1 原意）。
    // 【为什么废掉 η 曲率判据】旧式 steep = |η − 4邻均值| / h 是 **2 格曲率量**：
    // λ=40 m 涌浪上只有 ~1e-4 量级，判据阈值 0.78 永远够不着 → 泡沫恒 0、白水粒子恒 0。
    float fr = length(w.yz) / sqrt(_Gravity * max(hAdv, _DryDepth));
    float gen = (fr > _BreakingFroude) ? (fr - _BreakingFroude) * _FoamGain * _Dt : 0.0;

    // 衰减 + 邻域扩散（读 A 旧值的 4 邻均值）
    int il = (c.x > 0) ? i - 1 : i;
    int ir = (c.x < _Cells - 1) ? i + 1 : i;
    int idn = (c.y > 0) ? i - _Cells : i;
    int iup = (c.y < _Cells - 1) ? i + _Cells : i;
    float nMean = (_WaterA[il].w + _WaterA[ir].w + _WaterA[idn].w + _WaterA[iup].w) * 0.25;
    float f = (foam + gen) * _FoamDecay;
    f = lerp(f, nMean, _FoamDiffuse);
    f = clamp(f, 0.0, 1.0);

    _WaterB[i] = float4(hAdv, w.yz, f);
}

// ---- kernel：湿沙（浸润/蒸发/扩散 + 输出纹理，地形分辨率，读 C 写 D）----
[numthreads(8, 8, 1)]
void WetnessStep(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GroundCells || id.y >= (uint)_GroundCells) return;
    int2 c = int2(id.x, id.y);
    int i = c.x + c.y * _GroundCells;
    float wet = _WetA[i];

    // 水深采样：地形格中心对应的水格连续坐标 = (c+0.5)·(水格数/地形格数)
    float2 wc = (c + 0.5) * (_Cells / (float)_GroundCells);
    float2 p = clamp(wc, 0.0, _Cells - 1.0);
    int2 i0 = int2(floor(p));
    float2 fr = p - i0;
    int2 i1 = min(i0 + 1, _Cells - 1);
    // 最新水场在 B（AdvectFoam 之后）
    float h00 = _WaterB[i0.x + i0.y * _Cells].x;
    float h10 = _WaterB[i1.x + i0.y * _Cells].x;
    float h01 = _WaterB[i0.x + i1.y * _Cells].x;
    float h11 = _WaterB[i1.x + i1.y * _Cells].x;
    float h = lerp(lerp(h00, h10, fr.x), lerp(h01, h11, fr.x), fr.y);

    if (h > _DryDepth)
        wet = min(1.0, wet + _WetSoakRate * _Dt);
    else
        wet *= exp(-_WetEvaporateRate * _Dt);

    // 邻域扩散（读 C 旧值）
    int il = (c.x > 0) ? i - 1 : i;
    int ir = (c.x < _GroundCells - 1) ? i + 1 : i;
    int idn = (c.y > 0) ? i - _GroundCells : i;
    int iup = (c.y < _GroundCells - 1) ? i + _GroundCells : i;
    float nMean = (_WetA[il] + _WetA[ir] + _WetA[idn] + _WetA[iup]) * 0.25;
    wet = lerp(wet, nMean, _WetDiffuse);
    wet = clamp(wet, 0.0, 1.0);

    _WetB[i] = wet;
    _WaterLabWetTex[c] = wet;
}

// ---- kernel：输出打包（读 B，写 _WaterLabHeightTex）----
[numthreads(8, 8, 1)]
void OutputField(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Cells || id.y >= (uint)_Cells) return;
    int2 c = int2(id.x, id.y);
    int i = c.x + c.y * _Cells;
    // 读 A：本 kernel 在帧末 SurfaceUpdate（松弛后的最新场）之后派发，不是子步里的 B。
    float4 w = _WaterA[i];

    // η = ground + max(h − _DryDepth, 0)：发布出去的是**可见水深**（前 5 cm 结合水贴沙不可见）。
    // 渲染侧 depth = η − ground 直接得到 max(h−0.05,0)，与原作 Lit/Water VS 同语义。
    float g0 = SampleGround(c + 0.5);
    float eta = g0 + max(w.x - _DryDepth, 0.0);

    // 法线：η 的中心差分（反射边界取自身 → 单侧差分退化为 0）
    int il = (c.x > 0) ? i - 1 : i;
    int ir = (c.x < _Cells - 1) ? i + 1 : i;
    int idn = (c.y > 0) ? i - _Cells : i;
    int iup = (c.y < _Cells - 1) ? i + _Cells : i;
    float etaL = SampleGround(int2(max(c.x - 1, 0), c.y) + 0.5) + max(_WaterA[il].x - _DryDepth, 0.0);
    float etaR = SampleGround(int2(min(c.x + 1, _Cells - 1), c.y) + 0.5) + max(_WaterA[ir].x - _DryDepth, 0.0);
    float etaD = SampleGround(int2(c.x, max(c.y - 1, 0)) + 0.5) + max(_WaterA[idn].x - _DryDepth, 0.0);
    float etaU = SampleGround(int2(c.x, min(c.y + 1, _Cells - 1)) + 0.5) + max(_WaterA[iup].x - _DryDepth, 0.0);
    // 法线保持 1 格中心差分（原作同构）。曾试 2 格差分压「网格尺度碎金」——r54→r55
    // 实测曝光无关的局部高差指标几乎不动（>60 0.12%→0.12%），碎金并非来自模拟网格
    // 法线，故回退，避免无收益的偏离。
    float dx = (etaR - etaL) / (2.0 * _CellSize);
    float dz = (etaU - etaD) / (2.0 * _CellSize);
    // 水跃（bore）前沿的相邻格水深跳变会让坡度爆表 → 法线编码饱和到 ±1 →
    // 渲染侧法线与视线垂直、菲涅尔恒 1（整片水画成天空色，2026-10-14 实测）。
    // 钳到 ±0.6：牺牲前沿一两个格的法线保住整片海面的着色。
    dx = clamp(dx, -0.6, 0.6);
    dz = clamp(dz, -0.6, 0.6);
    float invLen = rsqrt(dx * dx + dz * dz + 1.0);

    // η 编码 [-3,2]→[0,1]；法线 xz [-1,1]→[0,1]；泡沫原值
    _WaterLabHeightTex[c] = float4(
        saturate((eta + 3.0) / 5.0),
        saturate(-dx * invLen * 0.5 + 0.5),
        saturate(-dz * invLen * 0.5 + 0.5),
        saturate(w.w));

    // 焦散烘焙：拉普拉斯 = 四邻 η 均值 − 中心（凹面聚光为正、凸面发散为负——
    // 重新分配光线、净量为零，基线必须 0）。原逐像素 5 采样现算整体撤出渲染
    // shader，换 1 次本 RT 采样；增益在材质侧 _CausticGain。
    float lap = (etaL + etaR + etaD + etaU) * 0.25 - eta;
    _WaterLabCausticTex[c] = float4(lap, 0.0, 0.0, 1.0);
}

// ---- kernel：白水粒子（W4，对标 Whitewater：泡沫场实例化粒子，
//      Compact 写 drawList、End 写 drawArgs——原作 Update→Culling 同构）----

// 帧首：清活粒子计数（写游标 [1] 不清——缓冲环跨步连续回卷覆盖最老粒子）
[numthreads(1, 1, 1)]
void WhitewaterBegin(uint3 id : SV_DispatchThreadID)
{
    _WWAlive[0] = 0;
}

// 泡沫场驱动生成：浓度超阈值的格按概率取环槽写入（读 B——AdvectFoam 后的最新泡沫）
[numthreads(8, 8, 1)]
void WhitewaterSpawn(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Cells || id.y >= (uint)_Cells) return;
    int2 c = int2(id.x, id.y);
    int i = c.x + c.y * _Cells;
    float foam = _WaterB[i].w;
    if (foam < _WwSpawnThreshold) return;

    // 两路哈希随机：r1 生成判定、r2 个体尺寸/位置抖动（无硬件 RNG，格号+时间混合）
    float r1 = frac(sin(i * 12.9898 + _Time * 91.7) * 43758.5453);
    float r2 = frac(sin(i * 78.233 - _Time * 57.3) * 24634.6345);
    float rate = (foam - _WwSpawnThreshold) * _WwSpawnRate * _Dt;
    if (r1 > rate) return;

    uint cursor;
    InterlockedAdd(_WWAlive[1], 1, cursor);
    uint slot = cursor % (uint)_WwCapacity;
    float2 jitter = (float2(r1, r2) * 2.0 - 1.0) * _CellSize;
    float2 worldXZ = -_HalfDomain + (c + 0.5) * _CellSize + jitter;
    // 原作白水 VS：worldY = max(amount−0.05, 0) + 0.02（无 floor，因为原作粒子在
    // 沙盘局部空间；本仓是世界空间，必须补 ground）。旧式 ground + h + 0.05 比
    // 可见水面高约 10 cm，退潮薄水膜上会浮起一条“白沫带”（r80 断带的一部分）。
    float surface = SampleGround(c + 0.5) + max(_WaterB[i].x - _DryDepth, 0.0);
    _WWPos[slot] = float4(worldXZ.x, surface + _WwSurfaceOffset, worldXZ.y, 1.0);
    _WWVel[slot] = float4(_WaterB[i].y * 0.6, 0.3, _WaterB[i].z * 0.6, _WwSize * (0.6 + 0.8 * r2));
}

// 积分：随速度场平流 + 弹簧贴水面（浮力近似）+ 寿命衰减；死粒子 w=0 留在环里等覆盖
[numthreads(64, 1, 1)]
void WhitewaterUpdate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_WwCapacity) return;
    float4 p = _WWPos[id.x];
    if (p.w <= 0.0) return;
    float4 v = _WWVel[id.x];

    // 世界坐标反查最近水格（不双线性——粒子视觉尺寸远大于半格误差）
    float2 cellF = (p.xz + _HalfDomain) / _CellSize - 0.5;
    int2 c = int2(clamp(round(cellF), float2(0.0, 0.0), float2(_Cells - 1, _Cells - 1)));
    // 与 Spawn 同一高度语义：可见水面 + 原作的 0.02 上抬。
    float hCell = _WaterB[c.x + c.y * _Cells].x;
    float surface = SampleGround(c + 0.5) + max(hCell - _DryDepth, 0.0);

    float damp = exp(-1.6 * _Dt);
    v.xyz *= damp;
    v.y += (surface + _WwSurfaceOffset - p.y) * 12.0 * _Dt;
    p.xyz += v.xyz * _Dt;
    p.w -= _Dt / _WwLifetime;
    _WWVel[id.x] = v;
    _WWPos[id.x] = float4(p.xyz, max(p.w, 0.0));
}

// 压缩：视野内活粒子槽位写入 draw list（对标原作 Culling kernel 的**相机视锥**那一路：
// 逐粒对 6 平面做内侧判定，外扩 _WwFrustumOverscan；原作另有阴影视锥那一路
// drawShadowList/argsShadow，我方白水不投影，无对应物）
[numthreads(64, 1, 1)]
void WhitewaterCompact(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_WwCapacity) return;
    float4 p = _WWPos[id.x];
    if (p.w <= 0.0) return;

    [unroll]
    for (int k = 0; k < 6; k++)
    {
        if (dot(_WwFrustumPlanes[k].xyz, p.xyz) + _WwFrustumPlanes[k].w < -_WwFrustumOverscan)
            return;
    }

    uint j;
    InterlockedAdd(_WWAlive[0], 1, j);
    _WWDraw[j] = id.x;
}

// 帧尾：写 DrawProceduralIndirect 参数（顶点数/实例数/起始顶点/起始实例）
[numthreads(1, 1, 1)]
void WhitewaterEnd(uint3 id : SV_DispatchThreadID)
{
    _WWArgs[0] = 6;
    _WWArgs[1] = min(_WWAlive[0], (uint)_WwCapacity);
    _WWArgs[2] = 0;
    _WWArgs[3] = 0;
}
