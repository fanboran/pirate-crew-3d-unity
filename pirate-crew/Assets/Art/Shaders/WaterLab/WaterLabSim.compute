// 实验水体 · 浅水方程模拟内核（W1）。
//
// 架构与公式单源：PirateCrew.WaterLab.WaterLabRules（纯 C#，harness 钉契约）；
// 参照思路来源：Sandcastle Demo 逆向（kernel 名与常量名见
// docs/技术/渲染/调研/Sandcastle水体逆向.md），代码自写，不含第三方代码。
//
// 缓冲约定（每帧调度序，A/B 交替读写保证 kernel 内全场一致）：
//   WaveSource        A→A（原地只改波源带与海绵带，无邻域读）
//   HeightIntegration A→B（质量通量，读 4 邻）
//   VelocityIntegration B→A（动量梯度，读 4 邻）
//   AdvectFoam        A→B（泡沫回溯/生成/衰减/扩散，读 4 邻）
//   WetnessStep       C→D（湿沙浸润/蒸发/扩散，读 4 邻，地形分辨率）
//   OutputField       读 B，写 _WaterLabHeightTex（水场输出，水分辨率）
// 帧末最新水场在 B、最新湿沙在 D；下一帧驱动侧把 (B,D) 当输入 (A,C)。
// 本文件不写任何数值常量的默认值——全部由 C# 侧按 WaterLabRules 下发（防双源漂移）。

#pragma kernel WaveSource
#pragma kernel HeightIntegration
#pragma kernel VelocityIntegration
#pragma kernel AdvectFoam
#pragma kernel WetnessStep
#pragma kernel OutputField

RWStructuredBuffer<float4> _WaterA;   // x=h(水深) y=vx z=vz w=foam，256²
RWStructuredBuffer<float4> _WaterB;
StructuredBuffer<float> _Ground;      // 地形高程（世界 Y），128²，只读静态
RWStructuredBuffer<float> _WetA;      // 湿沙 [0,1]，128²
RWStructuredBuffer<float> _WetB;
RWTexture2D<float4> _WaterLabHeightTex; // 输出：R=η(编码) G,B=法线xz(编码) A=泡沫（与渲染 shader 全局同名）
RWTexture2D<float> _WaterLabWetTex;     // 输出：R=湿沙（与渲染 shader 全局同名）

// ---- C# 下发常量（名字与 WaterLabRules 对齐）----
int _Cells;              // 水域每轴格数 (256)
float _CellSize;         // 水格距 (0.25)
int _GroundCells;        // 地形每轴格数 (128)
float _GroundCellSize;   // 地形格距 (0.5)
float _HalfDomain;       // 半域宽 (32)

float _Dt;
float _Gravity;
float _Damping;
float _MaxVelocity;
float _DryDepth;
float _Time;
float _SeaLevel;

float _WaveBandWidth;
// Shapiro 网格滤波强度（WaterLabRules.GridFilterEps）：h -= ε×(h−4邻均值)，带外全场——
// 压 2 格棋盘模（弱阻尼+弱松弛下无人看管会毁掉破碎判据与长波），对长波近乎无伤
float _GridFilterEps;
// 四列入射波（致敬 Sandcastle WavesProperty a/b/c/d 四列结构，数值 C# 侧重推）：
// A: xy=单位传播方向 z=波数k w=角频ω（浅水色散 ω=k·√(g·h带)，与 SWE 特征速匹配）；B: x=振幅 y=初相
float4 _WaveTrainsA[4];
float4 _WaveTrainsB[4];
// 潮位呼吸（Sandcastle UpdateAmount 实证：全场向 seaLevel+amp·sin(ωt) 松弛）
float _TideAmp;
float _TideOmega;
// 松弛深度系数 1/(s·m)：权重 = 此值 × 局部水深 × dt（UpdateAmount 同构，见 WaveSource）
float _TideRelaxRate;
float _WaveRelaxRate;

float _BreakingSteepness;
float _FoamGain;
float _FoamDecay;
float _FoamDiffuse;

float _WetSoakRate;
float _WetEvaporateRate;
float _WetDiffuse;

int _SpongeCells;
float _SpongeMaxDamping;

// ---- 共用采样 ----

// 水格坐标（连续，格心 +0.5）→ 地形高程，地形双线性（地形格距是水格 2 倍）
float SampleGround(float2 cellXY)
{
    float2 g = cellXY * _CellSize / _GroundCellSize; // 水格→地形格连续坐标
    float2 p = clamp(g, float2(0.5, 0.5), float2(_GroundCells - 1.5, _GroundCells - 1.5));
    int2 i0 = int2(floor(p - 0.5) + 0.5);
    float2 f = p - (i0 + 0.5);
    int2 i1 = min(i0 + 1, _GroundCells - 1);
    float a = _Ground[i0.x + i0.y * _GroundCells];
    float b = _Ground[i1.x + i0.y * _GroundCells];
    float c = _Ground[i0.x + i1.y * _GroundCells];
    float d = _Ground[i1.x + i1.y * _GroundCells];
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

// 水场 yzw（速度+泡沫）双线性采样（clamp 边界）
float3 SampleWaterVelFoam(RWStructuredBuffer<float4> buf, float2 cellXY)
{
    float2 p = clamp(cellXY, float2(0.0, 0.0), float2(_Cells - 1, _Cells - 1));
    int2 i0 = int2(floor(p));
    float2 f = p - i0;
    int2 i1 = min(i0 + 1, _Cells - 1);
    float4 a = buf[i0.x + i0.y * _Cells];
    float4 b = buf[i1.x + i0.y * _Cells];
    float4 c = buf[i0.x + i1.y * _Cells];
    float4 d = buf[i1.x + i1.y * _Cells];
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y).yzw;
}

// 距域边（z 两侧）的最小格距
float BorderDistance(int2 c)
{
    return min(c.y, _Cells - 1 - c.y);
}

// ---- kernel：波源 + 海绵（帧首，原地）----
// 波浪目标 = 潮位 + 四列行波叠加；注入带内强松弛（造波机），带外全场弱松弛向潮位
// （Sandcastle UpdateAmount 同构：潮位呼吸驱动岸线进退，行波只在注入带成形）。
[numthreads(8, 8, 1)]
void WaveSource(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Cells || id.y >= (uint)_Cells) return;
    int2 c = int2(id.x, id.y);
    int i = c.x + c.y * _Cells;
    float4 w = _WaterA[i];
    float g = SampleGround(c + 0.5);
    float eta = g + w.x;

    float2 worldXZ = -_HalfDomain + (c + 0.5) * _CellSize;
    float tide = _SeaLevel + _TideAmp * sin(_TideOmega * _Time);

    // 四列波叠加（波长互质 + 方向扇形展开 → 波峰线不重合，天然不规律）
    float etaTarget = tide;
    [unroll]
    for (int t = 0; t < 4; t++)
    {
        float2 d = _WaveTrainsA[t].xy;
        float phase = _WaveTrainsA[t].z * dot(d, worldXZ) - _WaveTrainsA[t].w * _Time + _WaveTrainsB[t].y;
        etaTarget += _WaveTrainsB[t].x * sin(phase);
    }

    float relax = min(1.0, _WaveRelaxRate * _Dt);
    if (worldXZ.x < -_HalfDomain + _WaveBandWidth)
    {
        // -x 域边波源带（宽度 _WaveBandWidth）：向行波目标强松弛（η 与向岸速度）。
        // 旧实现误写成 worldX < _WaveBandWidth（半张域被钉死在理想波上——「太规律」根因之一，
        // 2026-10-14 修正）：现在四列波从域边自然传播过浅水架，浅化/折射/干涉全交给物理。
        // 【速度配对】行波的深度平均速度 u = c/h·(η−潮位)，不是 celerity=√(gh)——
        // 直接钉 √(gh) 是 ~8× 过驱，带内激波化，长时程（30× 快进实拍）爆成全场
        // 短波垃圾 + 泡沫满格 + η 编码饱和。
        float etaNew = lerp(eta, etaTarget, relax);
        float hNew = max(etaNew - g, 0.0);
        float uTarget = (etaTarget - tide) * sqrt(_Gravity / max(hNew, 0.05));
        w = float4(hNew, lerp(w.y, uTarget, relax), w.z, w.w);
    }
    else
    {
        // 带外全场：向潮位弱松弛（岸线呼吸）。【权重 ∝ 水深】——原作 UpdateAmount
        // （Water_20632 反汇编）为 `amount += 水场×(1/15)×间隙`，干处权重 0 完全不松弛：
        // 深水被压平向潮位、浅水架几乎不阻尼，行波活着冲上滩。均匀权重对行波是
        // 指数阻尼（旧值 0.25/s → 衰减长度 14 m，涌浪没到岸就被吃光，第九轮根因）。
        float relaxT = min(1.0, _TideRelaxRate * w.x * _Dt);
        float etaNew = lerp(eta, tide, relaxT);
        w.x = max(etaNew - g, 0.0);
    }

    // Shapiro 网格滤波（带外）：压 2 格棋盘模，**四阶** x/y 两轴分离施加
    // （GridFilterEps 注释见规则单源：λ2 与旧二阶同杀、λ4–8 的 bore 陡 front 保留）。
    // 邻域读本步前值（两轴的 δ⁴ 都按旧场算，Jacobi 式）——带外每步松弛增量 ~1e-4 量级，
    // 同 dispatch 读写竞态的偏差无实质影响；带内不滤（造波机强松弛自洽，实验室按带外口径标定）。
    if (worldXZ.x >= -_HalfDomain + _WaveBandWidth)
    {
        int xm = (c.x > 0) ? i - 1 : i;
        int xp = (c.x < _Cells - 1) ? i + 1 : i;
        int x2m = (c.x > 1) ? i - 2 : i;
        int x2p = (c.x < _Cells - 2) ? i + 2 : i;
        int ym = (c.y > 0) ? i - _Cells : i;
        int yp = (c.y < _Cells - 1) ? i + _Cells : i;
        int y2m = (c.y > 1) ? i - 2 * _Cells : i;
        int y2p = (c.y < _Cells - 2) ? i + 2 * _Cells : i;
        float h = w.x;
        float d4x = _WaterA[x2p].x - 4.0 * _WaterA[xp].x + 6.0 * h - 4.0 * _WaterA[xm].x + _WaterA[x2m].x;
        float d4y = _WaterA[y2p].x - 4.0 * _WaterA[yp].x + 6.0 * h - 4.0 * _WaterA[ym].x + _WaterA[y2m].x;
        h -= _GridFilterEps * 0.0625 * (d4x + d4y);
        w.x = max(h, 0.0);
    }

    // z 两侧海绵：速度阻尼（平方曲线），吸收侧向行波
    float bd = BorderDistance(c);
    if (bd < (float)_SpongeCells)
    {
        float t2 = 1.0 - bd / max(_SpongeCells, 1);
        float sigma = _SpongeMaxDamping * t2 * t2;
        float damp = exp(-sigma * _Dt);
        w.yz *= damp;
    }

    _WaterA[i] = w;
}

// ---- kernel：质量方程（平均通量，读 A 写 B）----
[numthreads(8, 8, 1)]
void HeightIntegration(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Cells || id.y >= (uint)_Cells) return;
    int2 c = int2(id.x, id.y);
    int i = c.x + c.y * _Cells;
    float4 w = _WaterA[i];
    float h = w.x;

    // 4 邻（bool 标记出界＝反射墙）。墙界面质量通量显式为 0——「越界取自身」会留
    // F = h·v 的假通量破坏守恒（与 CPU 参考同式，harness 钉契约）。
    bool bl = c.x > 0;
    bool br = c.x < _Cells - 1;
    bool bd = c.y > 0;
    bool bu = c.y < _Cells - 1;
    float4 wl = _WaterA[bl ? i - 1 : i];
    float4 wr = _WaterA[br ? i + 1 : i];
    float4 wd = _WaterA[bd ? i - _Cells : i];
    float4 wu = _WaterA[bu ? i + _Cells : i];

    // 平均通量 F = h̄·v̄（半格界面）。界面级干湿 gate：两侧水深都超阈值该界面才流动——
    // 两侧格对同一界面必须算出同一判定与通量，否则质量不守恒（与 CPU 参考同式）。
    float fluxL = (bl && wl.x > _DryDepth && h > _DryDepth) ? ((wl.x + h) * 0.5) * ((wl.y + w.y) * 0.5) : 0.0;
    float fluxR = (br && h > _DryDepth && wr.x > _DryDepth) ? ((h + wr.x) * 0.5) * ((w.y + wr.y) * 0.5) : 0.0;
    float fluxD = (bd && wd.x > _DryDepth && h > _DryDepth) ? ((wd.x + h) * 0.5) * ((wd.z + w.z) * 0.5) : 0.0;
    float fluxU = (bu && h > _DryDepth && wu.x > _DryDepth) ? ((h + wu.x) * 0.5) * ((w.z + wu.z) * 0.5) : 0.0;

    float hNew = h - _Dt / _CellSize * ((fluxR - fluxL) + (fluxU - fluxD));
    hNew = max(hNew, 0.0); // 无负水深（数值保护）

    _WaterB[i] = float4(hNew, w.yzw);
}

// ---- kernel：动量方程（水面高程梯度，读 B 写 A）----
[numthreads(8, 8, 1)]
void VelocityIntegration(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Cells || id.y >= (uint)_Cells) return;
    int2 c = int2(id.x, id.y);
    int i = c.x + c.y * _Cells;
    float4 w = _WaterB[i];

    if (w.x <= _DryDepth)
    {
        _WaterA[i] = float4(w.x, 0, 0, w.w);
        return;
    }

    int il = (c.x > 0) ? i - 1 : i;
    int ir = (c.x < _Cells - 1) ? i + 1 : i;
    int idn = (c.y > 0) ? i - _Cells : i;
    int iup = (c.y < _Cells - 1) ? i + _Cells : i;
    float4 wl = _WaterB[il];
    float4 wr = _WaterB[ir];
    float4 wd = _WaterB[idn];
    float4 wu = _WaterB[iup];

    // η = ground + h：动量由水面梯度驱动（干前滩上水往低处流）
    float g0 = SampleGround(c + 0.5);
    float etaL = SampleGround(max(c - int2(1, 0), int2(0, 0)) + 0.5) + wl.x;
    float etaR = SampleGround(min(c + int2(1, 0), int2(_Cells - 1, _Cells - 1)) + 0.5) + wr.x;
    float etaD = SampleGround(max(c - int2(0, 1), int2(0, 0)) + 0.5) + wd.x;
    float etaU = SampleGround(min(c + int2(0, 1), int2(_Cells - 1, _Cells - 1)) + 0.5) + wu.x;

    float sx = (etaR - etaL) / (2.0 * _CellSize);
    float sz = (etaU - etaD) / (2.0 * _CellSize);

    float vx = w.y - _Dt * (_Gravity * sx + _Damping * w.y);
    float vz = w.z - _Dt * (_Gravity * sz + _Damping * w.z);

    // 限幅
    float sp = length(float2(vx, vz));
    if (sp > _MaxVelocity)
    {
        float k = _MaxVelocity / sp;
        vx *= k;
        vz *= k;
    }

    _WaterA[i] = float4(w.x, vx, vz, w.w);
}

// ---- kernel：泡沫（回溯 + 破碎生成 + 衰减 + 扩散，读 A 写 B）----
[numthreads(8, 8, 1)]
void AdvectFoam(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Cells || id.y >= (uint)_Cells) return;
    int2 c = int2(id.x, id.y);
    int i = c.x + c.y * _Cells;
    float4 w = _WaterA[i];

    // 半拉格朗日回溯：沿速度场反推采样点
    float2 back = (c + 0.5) - w.yz * _Dt / _CellSize;
    float3 sampled = SampleWaterVelFoam(_WaterA, back);
    float foam = sampled.z; // 旧泡沫浓度（回溯点）

    // 破碎生成：波面陡度超过判据
    int il = (c.x > 0) ? i - 1 : i;
    int ir = (c.x < _Cells - 1) ? i + 1 : i;
    int idn = (c.y > 0) ? i - _Cells : i;
    int iup = (c.y < _Cells - 1) ? i + _Cells : i;
    float g0 = SampleGround(c + 0.5);
    float eta = g0 + w.x;
    float meanEta = (SampleGround(int2(max(c.x - 1, 0), c.y) + 0.5) + _WaterA[il].x
                   + SampleGround(int2(min(c.x + 1, _Cells - 1), c.y) + 0.5) + _WaterA[ir].x
                   + SampleGround(int2(c.x, max(c.y - 1, 0)) + 0.5) + _WaterA[idn].x
                   + SampleGround(int2(c.x, min(c.y + 1, _Cells - 1)) + 0.5) + _WaterA[iup].x) * 0.25;
    float steep = abs(eta - meanEta) / max(w.x, _DryDepth);
    float gen = (steep > _BreakingSteepness) ? (steep - _BreakingSteepness) * _FoamGain * _Dt : 0.0;

    // 衰减 + 邻域扩散（读 A 旧值的 4 邻均值）
    float nMean = (_WaterA[il].w + _WaterA[ir].w + _WaterA[idn].w + _WaterA[iup].w) * 0.25;
    float f = (foam + gen) * _FoamDecay;
    f = lerp(f, nMean, _FoamDiffuse);
    f = clamp(f, 0.0, 1.0);

    _WaterB[i] = float4(w.x, w.yz, f);
}

// ---- kernel：湿沙（浸润/蒸发/扩散 + 输出纹理，地形分辨率，读 C 写 D）----
[numthreads(8, 8, 1)]
void WetnessStep(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GroundCells || id.y >= (uint)_GroundCells) return;
    int2 c = int2(id.x, id.y);
    int i = c.x + c.y * _GroundCells;
    float wet = _WetA[i];

    // 水深采样：地形格中心对应的水格连续坐标 = (c+0.5)·(水格数/地形格数)
    float2 wc = (c + 0.5) * (_Cells / (float)_GroundCells);
    float2 p = clamp(wc, 0.0, _Cells - 1.0);
    int2 i0 = int2(floor(p));
    float2 fr = p - i0;
    int2 i1 = min(i0 + 1, _Cells - 1);
    // 最新水场在 B（AdvectFoam 之后）
    float h00 = _WaterB[i0.x + i0.y * _Cells].x;
    float h10 = _WaterB[i1.x + i0.y * _Cells].x;
    float h01 = _WaterB[i0.x + i1.y * _Cells].x;
    float h11 = _WaterB[i1.x + i1.y * _Cells].x;
    float h = lerp(lerp(h00, h10, fr.x), lerp(h01, h11, fr.x), fr.y);

    if (h > _DryDepth)
        wet = min(1.0, wet + _WetSoakRate * _Dt);
    else
        wet *= exp(-_WetEvaporateRate * _Dt);

    // 邻域扩散（读 C 旧值）
    int il = (c.x > 0) ? i - 1 : i;
    int ir = (c.x < _GroundCells - 1) ? i + 1 : i;
    int idn = (c.y > 0) ? i - _GroundCells : i;
    int iup = (c.y < _GroundCells - 1) ? i + _GroundCells : i;
    float nMean = (_WetA[il] + _WetA[ir] + _WetA[idn] + _WetA[iup]) * 0.25;
    wet = lerp(wet, nMean, _WetDiffuse);
    wet = clamp(wet, 0.0, 1.0);

    _WetB[i] = wet;
    _WaterLabWetTex[c] = wet;
}

// ---- kernel：输出打包（读 B，写 _WaterLabHeightTex）----
[numthreads(8, 8, 1)]
void OutputField(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Cells || id.y >= (uint)_Cells) return;
    int2 c = int2(id.x, id.y);
    int i = c.x + c.y * _Cells;
    float4 w = _WaterB[i];

    // 【二分诊断 2】eta+泡沫真实编码、法线固定 0.5——定位 NaN 在上游哪一环。
    float g0 = SampleGround(c + 0.5);
    float eta = g0 + w.x;

    // 法线：η 的中心差分（反射边界取自身 → 单侧差分退化为 0）
    int il = (c.x > 0) ? i - 1 : i;
    int ir = (c.x < _Cells - 1) ? i + 1 : i;
    int idn = (c.y > 0) ? i - _Cells : i;
    int iup = (c.y < _Cells - 1) ? i + _Cells : i;
    float etaL = SampleGround(int2(max(c.x - 1, 0), c.y) + 0.5) + _WaterB[il].x;
    float etaR = SampleGround(int2(min(c.x + 1, _Cells - 1), c.y) + 0.5) + _WaterB[ir].x;
    float etaD = SampleGround(int2(c.x, max(c.y - 1, 0)) + 0.5) + _WaterB[idn].x;
    float etaU = SampleGround(int2(c.x, min(c.y + 1, _Cells - 1)) + 0.5) + _WaterB[iup].x;
    float dx = (etaR - etaL) / (2.0 * _CellSize);
    float dz = (etaU - etaD) / (2.0 * _CellSize);
    // 水跃（bore）前沿的相邻格水深跳变会让坡度爆表 → 法线编码饱和到 ±1 →
    // 渲染侧法线与视线垂直、菲涅尔恒 1（整片水画成天空色，2026-10-14 实测）。
    // 钳到 ±0.6：牺牲前沿一两个格的法线保住整片海面的着色。
    dx = clamp(dx, -0.6, 0.6);
    dz = clamp(dz, -0.6, 0.6);
    float invLen = rsqrt(dx * dx + dz * dz + 1.0);

    // η 编码 [-3,2]→[0,1]；法线 xz [-1,1]→[0,1]；泡沫原值
    _WaterLabHeightTex[c] = float4(
        saturate((eta + 3.0) / 5.0),
        saturate(-dx * invLen * 0.5 + 0.5),
        saturate(-dz * invLen * 0.5 + 0.5),
        saturate(w.w));
}
